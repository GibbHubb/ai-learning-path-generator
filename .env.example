# ai-learning-path-generator — environment configuration
#
# AP38: this file used to list 4 variables while the code read ~14, and the one
# frontend variable it named (VITE_API_URL) had no effect. The list below is now
# derived-and-enforced: tests/test_config_ap38.py walks the source for every
# os.getenv / config.require / config.optional / config.bool_flag literal and every
# import.meta.env.VITE_* and fails if any is missing here. Keep it complete.
#
# [required in production] = the app refuses to start or raises at call time if unset
#                            when ENVIRONMENT != development (see backend/config.py).
# [optional]               = has a safe default.

# --- environment -----------------------------------------------------------------
# development | production. Controls whether an unset required variable raises.
ENVIRONMENT=development

# --- secrets / auth ---------------------------------------------------------------
# [required in production] HMAC key for unsubscribe tokens. If unset, tokens are
# forgeable — do NOT rely on the development fallback outside a laptop.
SECRET_KEY=change-me-to-a-long-random-string

# [optional] Session/anon cookies get the Secure attribute. Defaults ON. Set to 0
# ONLY for local HTTP development.
APP_COOKIE_SECURE=1

# [optional] Shared secret for POST /api/jobs/run-reminders (the X-Cron-Secret
# header). If unset, that route is DISABLED (503) rather than open. (AP32)
CRON_SECRET=

# --- AI providers -----------------------------------------------------------------
# [required in production] OpenAI key for path generation and gpt-4o feedback.
OPENAI_API_KEY=your_openai_api_key_here
# [optional] Anthropic key, if the Anthropic path is used.
ANTHROPIC_API_KEY=

# --- database ---------------------------------------------------------------------
# [optional] Defaults to local SQLite. Set a Postgres URL in production.
DATABASE_URL=sqlite:///./learning_paths.db

# --- CORS / URLs ------------------------------------------------------------------
# [required in production] Comma-separated allowed origins. allow_credentials is on,
# so this must NOT fall back to localhost on a live site.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# [optional] Public base URL of the frontend (used in emailed links).
APP_BASE_URL=http://localhost:5173
# [optional] Origin allowed to embed / call back (magic-link redirects).
FRONTEND_ORIGIN=http://localhost:5173
# [optional] Public URL of this backend (used in OG cards / emailed links).
PUBLIC_BACKEND_URL=http://localhost:8000

# --- email (Resend) ---------------------------------------------------------------
# [optional] Resend API key. Unset falls back to console-log (no email sent).
RESEND_API_KEY=
# [optional] From address for reminder emails.
RESEND_FROM_EMAIL=

# --- frontend (Vite) --------------------------------------------------------------
# [required for a built frontend] Base URL the SPA calls. Was VITE_API_URL, which
# nothing reads — the code uses import.meta.env.VITE_API_BASE.
VITE_API_BASE=http://localhost:8000
