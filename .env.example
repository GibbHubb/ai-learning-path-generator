# ai-learning-path-generator — environment configuration
#
# AP38: this file used to list 4 variables while the code read ~14, and the one
# frontend variable it named (VITE_API_URL) had no effect. The list below is now
# derived-and-enforced: tests/test_config_ap38.py walks the source for every
# os.getenv / config.require / config.optional / config.bool_flag literal and every
# import.meta.env.VITE_* and fails if any is missing here. Keep it complete.
#
# [required in production] = the app refuses to start or raises at call time if unset
#                            when ENVIRONMENT != development (see backend/config.py).
# [optional]               = has a safe default.

# --- environment -----------------------------------------------------------------
# development | production. Controls whether an unset required variable raises.
ENVIRONMENT=development

# --- secrets / auth ---------------------------------------------------------------
# [required in production] HMAC key for unsubscribe tokens. If unset, tokens are
# forgeable — do NOT rely on the development fallback outside a laptop.
SECRET_KEY=change-me-to-a-long-random-string

# [optional] Session/anon cookies get the Secure attribute. Defaults ON. Set to 0
# ONLY for local HTTP development.
APP_COOKIE_SECURE=1

# [optional] Shared secret for POST /api/jobs/run-reminders (the X-Cron-Secret
# header). If unset, that route is DISABLED (503) rather than open. (AP32)
CRON_SECRET=

# --- AI providers -----------------------------------------------------------------
# [required in production] Google Gemini key (free tier, no card: aistudio.google.com).
# Powers path generation, difficulty adjustment, resource links and quizzes. (AP46)
GEMINI_API_KEY=your_gemini_api_key_here
# [optional] Model overrides. LLM_MODEL writes paths (default gemini-3.6-flash, 5 req/min
# free); LLM_LIGHT_MODEL does resource links + quizzes (default gemini-3.5-flash-lite).
LLM_MODEL=
LLM_LIGHT_MODEL=
# [optional] Paid fallback, used only when GEMINI_API_KEY is unset.
OPENAI_API_KEY=

# --- database ---------------------------------------------------------------------
# [optional] Defaults to local SQLite. Set a Postgres URL in production.
DATABASE_URL=sqlite:///./learning_paths.db

# --- rate limiting (AP35) ----------------------------------------------------------
# [optional] Trust the leftmost X-Forwarded-For entry as the visitor's IP for rate
# limiting. Set to 1 on Vercel (the platform's forwarding layer sets this header
# correctly). Leave UNSET for local dev — with it off, a forged header cannot bypass
# the limiter, and the fallback key is the raw peer address (see backend/rate_limit.py).
TRUSTED_PROXY_HEADER=
# Note: RATE_LIMIT / RATE_LIMIT_WINDOW (5 requests / 60s per visitor, per route) are
# code constants at the top of backend/rate_limit.py, not env vars — tune them there.
# Limited routes: POST /api/generate, /api/generate/stream,
# /api/milestones/{id}/feedback, /api/milestones/{id}/quiz/regenerate.

# --- model call budget (AP36) ------------------------------------------------------
# [optional] Total model calls (across every route above) allowed per UTC day, across
# every visitor. Unset means UNLIMITED (one startup WARNING, not a hard stop) — Max's
# call: a low default would 503 a working app on deploy. Once spent, the limited
# routes return 503 and the provider client is never constructed for that request.
# See GET /api/admin/usage (CRON_SECRET-gated) for today's count.
DAILY_CALL_BUDGET=

# --- CORS / URLs ------------------------------------------------------------------
# [required in production] Comma-separated allowed origins. allow_credentials is on,
# so this must NOT fall back to localhost on a live site.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# [optional] Public base URL of the frontend (used in emailed links).
APP_BASE_URL=http://localhost:5173
# [optional] Origin allowed to embed / call back (magic-link redirects).
FRONTEND_ORIGIN=http://localhost:5173
# [optional] Public URL of this backend (used in OG cards / emailed links).
PUBLIC_BACKEND_URL=http://localhost:8000

# --- email (Resend) ---------------------------------------------------------------
# [optional] Resend API key. Unset falls back to console-log (no email sent).
RESEND_API_KEY=
# [optional] From address for reminder emails.
RESEND_FROM_EMAIL=

# --- frontend (Vite) --------------------------------------------------------------
# [required for a built frontend] Base URL the SPA calls. Was VITE_API_URL, which
# nothing reads — the code uses import.meta.env.VITE_API_BASE.
VITE_API_BASE=http://localhost:8000
